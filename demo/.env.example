# ---------------------------------------------------------------------------
# AnyCompany Energy demo — Strands agents runtime config (EXAMPLE / TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to demo/.env and fill in the values from YOUR OWN stack
# outputs after running `cdk deploy`. Do NOT commit a populated demo/.env —
# it is gitignored on purpose. Only this *.example template is tracked.
#
# The demo runs the Strands agents in process, so it only needs to know which
# region to call Bedrock in, which Knowledge Base to use for RAG, and which
# Guardrail to apply. Get these from the stack outputs:
#   aws cloudformation describe-stacks \
#     --stack-name MultiAgentCustomerServiceStack \
#     --query "Stacks[0].Outputs" --output table
#
# Then load before launching the Streamlit app:
#   set -a && source demo/.env && set +a
#   streamlit run app.py
# ---------------------------------------------------------------------------

# AWS region the stack was deployed to — CloudFormation output: Region.
# The inference-profile geo (us./eu./apac.) is auto-detected from this.
export AWS_REGION=us-east-1

# Bedrock Knowledge Base id used for RAG — CloudFormation output: KnowledgeBaseId.
# The billing/escalation agents use the `retrieve` tool, which reads this.
export STRANDS_KNOWLEDGE_BASE_ID=REPLACE_WITH_YOUR_KNOWLEDGE_BASE_ID

# Bedrock Guardrail applied to every model call — CloudFormation output: GuardrailId.
export GUARDRAIL_ID=REPLACE_WITH_YOUR_GUARDRAIL_ID

# Guardrail version to apply (DRAFT is fine for the demo).
export GUARDRAIL_VERSION=DRAFT

# ---------------------------------------------------------------------------
# Optional overrides (sensible defaults are used if unset)
# ---------------------------------------------------------------------------
# Base foundation models (the geo prefix us./eu. is added automatically):
# export SUPERVISOR_MODEL_ID=anthropic.claude-opus-4-6
# export SPECIALIST_MODEL_ID=anthropic.claude-sonnet-4-6
#
# Force a specific inference-profile geo instead of auto-detecting from region:
# export INFERENCE_PROFILE_GEO=US        # US | EU | APAC
#
# Rebrand the assistant without code changes:
# export COMPANY_NAME="AnyCompany Energy"
# export COMPANY_SHORT_NAME="AnyCompany"
