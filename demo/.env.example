# ---------------------------------------------------------------------------
# AnyCompany Energy demo — Bedrock supervisor agent wiring (EXAMPLE / TEMPLATE)
# ---------------------------------------------------------------------------
# Copy this file to demo/.env and fill in the values from YOUR OWN stack
# outputs after running `cdk deploy`. Do NOT commit a populated demo/.env —
# it is gitignored on purpose. Only this *.example template is tracked.
#
# How to get these values after deploying:
#   aws cloudformation describe-stacks \
#     --stack-name MultiAgentCustomerServiceStack \
#     --query "Stacks[0].Outputs" --output table
#
# Then load before launching the Streamlit app:
#   set -a && source demo/.env && set +a
#   streamlit run demo/app.py
# ---------------------------------------------------------------------------

# Supervisor (intent-router) agent id — CloudFormation output: SupervisorAgentId
export SUPERVISOR_AGENT_ID=REPLACE_WITH_YOUR_SUPERVISOR_AGENT_ID

# Supervisor agent alias id — CloudFormation output: SupervisorAgentAliasId
export SUPERVISOR_AGENT_ALIAS_ID=REPLACE_WITH_YOUR_SUPERVISOR_AGENT_ALIAS_ID

# AWS region the stack was deployed to — CloudFormation output: Region
export AWS_REGION=us-east-1

# Bedrock Guardrail applied to all agents — CloudFormation output: GuardrailId.
# The agents enforce the guardrail automatically; this is documented here for
# reference / observability only.
export GUARDRAIL_ID=REPLACE_WITH_YOUR_GUARDRAIL_ID
